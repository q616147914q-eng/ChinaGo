{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "installCommand": "",
  "builds": [
    {
      "src": "server.mjs",
      "use": "@vercel/node"
    }
  ],
  "functions": {
    "server.mjs": {
      "includeFiles": [
        "index.html",
        "public/**",
        "src/**"
      ]
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "server.mjs"
    }
  ]
}